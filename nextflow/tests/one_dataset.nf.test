nextflow_pipeline {

    name "one_dataset end-to-end"
    script "nextflow/one_dataset.nf"

    test("combines batches and passes the built-in sanity check") {

        setup {
            def smiles = new File("$baseDir/example/example_data.csv").readLines()[0..11].collect { it.split(',')[1] }
            new File("$outputDir/smiles.txt").text = smiles.join('\n') + '\n'
        }

        when {
            params {
                smiles = "$outputDir/smiles.txt"
                batch_size = 13
                cpus = 2
                sanity_check = true
                sanity_samples = 20
                out = "$outputDir"
            }
        }

        then {
            assert workflow.success
            assert path("${params.out}/combined.hdf5").exists()
            assert path("${params.out}/sanity_report.txt").text.contains("True")
        }
    }
}
