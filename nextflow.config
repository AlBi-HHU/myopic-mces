// ── Default parameters for MCES Nextflow workflows ──────────────────────────
// Override on the command line: nextflow run nextflow/one_dataset.nf --smiles foo.txt
//
// Run directly from GitHub (any branch/tag/commit, no manual clone needed):
//   nextflow run AlBi-HHU/myopic-mces -r <branch> --smiles foo.txt

manifest {
    name = 'myopic-mces'
    description = 'Pairwise MCES distance computation pipeline'
    mainScript = 'main.nf'
    defaultBranch = 'main'
}

params {
    // input — one-dataset mode
    smiles = null

    // input — two-dataset mode (smiles_a = main, smiles_b = extra/cross)
    smiles_a = null
    smiles_b = null

    // computation
    threshold = 10
    solver = 'CPLEX_PY'            // used only when cplex_home is set; needs the cplex/docplex
                                   //   Python packages (baked into the image) plus a locally
                                   //   licensed CPLEX Optimization Studio install (cplex_home)
    cplex_home = null              // set to a CPLEX Optimization Studio install dir to enable CPLEX;
                                   //   bind-mounted into the container and used to upgrade
                                   //   cplex/docplex to that version
    choose_bound_dynamically = false
    solver_time_limit_seconds = null   // per-instance ILP solver time limit; unset = no limit
    cpus = 8                       // cores per COMPUTE_BATCH task.
                                    //   Set to your node's total core count to run one batch at
                                    //   a time, each using all cores. Lower values = more batches
                                    //   in parallel, fewer cores each.
                                    //   Under -profile slurm, this is also what makes each task
                                    //   consume a whole node: set it to that node type's core count.

    // prepare_input
    batch_size = 224960000

    // db lookup (optional; needs PGHOST/PGDATABASE/... env vars)
    use_db_lookup = false

    // write computed distances to the mces database (optional; needs
    // PGHOST/PGDATABASE/... env vars, and the mces-database package's
    // `import-mces` CLI on PATH)
    write_to_db = false

    // sanity check
    sanity_check = false
    sanity_samples = 10000

    // output
    out = 'results'

    // -profile draco / -profile ara
    slurm_options = ''             // extra sbatch args, e.g. '--account=... --qos=...'
    container_image = 'docker://git.uni-jena.de:5050/bioinf-mit/ms/mces/myopic-mces:latest'
                                    // override with --container_image for a different tag/path
}

// ── Container (uncomment and set to your image to enable outside of -profile draco/ara) ──
// process.container = 'myopic-mces:latest'

// ── SLURM execution profiles: nextflow run ... -profile draco (or ara) ──────
// PREPARE_INPUT runs locally (e.g. on the login node, under screen); everything
// else (COMPUTE_BATCH, COMBINE_BATCHES, SANITY_CHECK, WRITE_TO_DB) is submitted
// to slurm, one job per task, via singularity.
profiles {
    draco {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = params.container_image
        params.batch_size = 5000000

        process {
            executor = 'slurm'
            queue = 'standard,short,long,interactive'
            time = '3h'
            clusterOptions = params.slurm_options

            withName: 'PREPARE_INPUT_.*' {
                executor = 'local'
            }
            withName: 'WRITE_TO_DB' {
                executor = 'local'
            }
            withName: 'COMPUTE_BATCH' {
                maxForks = 10           // at most this many batches running at once
                cpus = 96               // standard partition node core count
                clusterOptions = "${params.slurm_options} --exclusive"
                errorStrategy = 'finish'
            }
            withName: 'COMBINE_BATCHES' {
                memory = { task.attempt == 1 ? 250.GB : 1.TB }
                errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }   // OOM exit codes
                maxRetries = 1
            }
        }
        // TODO: draco also has a 'short' partition — needs extra config
        // (different time limit / withLabel split) to make use of it.
    }

    ara {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = params.container_image

        process {
            executor = 'slurm'
            queue = 'b_standard,s_standard'
            time = '8d 8h'
            clusterOptions = params.slurm_options

            withName: 'PREPARE_INPUT_.*' {
                executor = 'local'
            }
            withName: 'WRITE_TO_DB' {
                executor = 'local'
            }
            withName: 'COMPUTE_BATCH' {
                maxForks = 4            // at most this many batches running at once
                clusterOptions = "${params.slurm_options} --exclusive"
                errorStrategy = 'finish'
                // TODO: set cpus to b_standard/s_standard's node core count once known
            }
        }
    }
}
